def caesar_cipher(text, k):
    result = ""
    for ch in text:
        if ch.isupper():
            result += chr((ord(ch) - ord('A') + k) % 26 + ord('A'))
        elif ch.islower():
            result += chr((ord(ch) - ord('a') + k) % 26 + ord('a'))
        else:
            result += ch
    return result
text = input("Enter the message: ")
k = int(input("Enter the shift value (1-25): "))
if 1 <= k <= 25:
    print("Encrypted message:", caesar_cipher(text, k))
else:
    print("Invalid shift value")
