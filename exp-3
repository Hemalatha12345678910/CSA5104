def playfair(text, key):
    key = ''.join(dict.fromkeys(key.upper().replace('J', 'I')))
    s = key + ''.join(c for c in "ABCDEFGHIKLMNOPQRSTUVWXYZ" if c not in key)
    m = [s[i:i+5] for i in range(0, 25, 5)]
    text = text.upper().replace('J', 'I')
    if len(text) % 2:
        text += 'X'
    result = ""
    for i in range(0, len(text), 2):
        a, b = text[i], text[i+1]
        r1, c1 = next((r, c) for r in range(5) for c in range(5) if m[r][c] == a)
        r2, c2 = next((r, c) for r in range(5) for c in range(5) if m[r][c] == b)
        if r1 == r2:
            result += m[r1][(c1+1)%5] + m[r2][(c2+1)%5]
        elif c1 == c2:
            result += m[(r1+1)%5][c1] + m[(r2+1)%5][c2]
        else:
            result += m[r1][c2] + m[r2][c1]
    return result
key = input("Enter key: ")
text = input("Enter plaintext: ")
print("Encrypted text:", playfair(text, key))
