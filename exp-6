import string
from collections import Counter
from math import gcd
alphabet = string.ascii_uppercase
ciphertext = input("Enter the ciphertext: ").upper()
freq = Counter(c for c in ciphertext if c in alphabet)
print("Most frequent letters:", freq.most_common(2))
for a in range(1, 26):
    if gcd(a, 26) == 1:
        a_inv = pow(a, -1, 26)
        for b in range(26):
            plaintext = ""
            for ch in ciphertext:
                if ch in alphabet:
                    c = ord(ch) - ord('A')
                    p = (a_inv * (c - b)) % 26
                    plaintext += chr(p + ord('A'))
                else:
                    plaintext += ch
            print(f"a={a}, b={b}: {plaintext}")
